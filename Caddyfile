projectly.ru {
    encode gzip

    handle /api/* {
        reverse_proxy projectly_nginx:4242
    }

    handle /media/* {
        reverse_proxy projectly_nginx:4242
    }

    handle /my/* {
        reverse_proxy projectly_nginx:4242
    }

    handle {
        reverse_proxy projectly_landing:3000
    }
}

